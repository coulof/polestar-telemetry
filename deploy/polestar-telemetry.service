# systemd *user* unit: starts the compose stack at boot (needs `loginctl enable-linger <user>`).
# Install: cp to ~/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable --now polestar-telemetry
[Unit]
Description=Polestar telemetry (podman-compose)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=30
WorkingDirectory=%h/src/polestar-telemetry
# Address the dashboard binds to. Set your private (for example Tailscale) address with a drop-in:
#   systemctl --user edit polestar-telemetry   (add under [Service]:  Environment=BIND_ADDR=<address>)
Environment=BIND_ADDR=127.0.0.1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Wait until some interface holds BIND_ADDR (a private-network address may come up after boot).
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do ip -4 -o addr show | grep -q " $BIND_ADDR/" && exit 0; sleep 2; done; echo "$BIND_ADDR not up" >&2; exit 1'
ExecStart=%h/.local/bin/podman-compose up -d
ExecStop=%h/.local/bin/podman-compose down
TimeoutStartSec=300

[Install]
WantedBy=default.target
