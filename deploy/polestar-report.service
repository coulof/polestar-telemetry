# systemd *user* unit: writes the due Claude reports (week, month, quarter, year; see report.sh).
# Triggered daily by polestar-report.timer; it only calls Claude for periods that have no report yet.
[Unit]
Description=Polestar Claude reports (Claude CLI)
After=polestar-telemetry.service

[Service]
Type=oneshot
ExecStart=%h/src/polestar-telemetry/deploy/report.sh
TimeoutStartSec=1800
