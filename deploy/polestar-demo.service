# systemd *user* unit: the public demo container (demo/compose.yml), synthetic data, 127.0.0.1:8599.
# Install: cp to ~/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable --now polestar-demo
[Unit]
Description=Polestar telemetry public demo (podman-compose)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/src/polestar-telemetry
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/podman-compose -f demo/compose.yml up -d --build
ExecStop=%h/.local/bin/podman-compose -f demo/compose.yml down
TimeoutStartSec=600

[Install]
WantedBy=default.target
